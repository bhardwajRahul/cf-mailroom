{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/mcp",
    "src/worker/email/attachments.ts",
    "src/worker/email/compose.ts",
    "src/worker/email/reply.ts",
    "src/worker/email/rules.ts",
    "src/worker/email/send-budget.ts",
    "src/worker/email/send.ts",
    "src/worker/inbox/conversations.ts",
    "src/shared"
  ]
}
