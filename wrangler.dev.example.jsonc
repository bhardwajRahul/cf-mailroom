// Copy to wrangler.dev.jsonc and fill in your database_id.
// Local-dev-only config: no `ai` / `send_email` bindings, because both force a
// remote proxy session and neither is needed for UI iteration.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-inbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cdn-cgi/handler/email"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-inbox",
      // Any value works for --local; use the real id if you also query remote.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "agentic-inbox-raw"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DRAFT_QUEUE",
        "queue": "agentic-inbox-drafts-dev"
      }
    ],
    "consumers": [
      {
        "queue": "agentic-inbox-drafts-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 1
      }
    ]
  }
}
