{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-inbox-mcp",
  "workers_dev": false,
  "main": "src/mcp/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "mcp.lessbutbetter.studio",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-inbox",
      "database_id": "c4bee2a2-df80-45f0-9df5-4a1d9804d0a0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b350a7fa9b484ddaadf72ddc17d42934"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "agentic-inbox-raw"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://lessbutbetter.cloudflareaccess.com",
    "POLICY_AUD": "1c0b0e684fe033019bc88dc2d3a7f2a7460dce08ffe1217a660544ab75c189eb",
    "MCP_ALLOWED_EMAILS": "wonderfuly@gmail.com",
    "MCP_SEND_ENABLED": "true",
    "MCP_DAILY_SEND_LIMIT": "100",
    "MCP_HOSTNAME": "mcp.lessbutbetter.studio",
    "WEB_APP_URL": "https://agentic-inbox.wong2.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
