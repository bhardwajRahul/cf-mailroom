{
  "name": "agentic-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "deploy": "npm run build && wrangler deploy --config dist/agentic_inbox/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply agentic-inbox --local",
    "db:migrate": "wrangler d1 migrations apply agentic-inbox --remote",
    "db:seed:local": "wrangler d1 execute agentic-inbox --local --file=./scripts/seed.sql",
    "email:test": "curl -X POST 'http://localhost:8787/cdn-cgi/handler/email?from=customer@example.com&to=support@ccchannel.dev' -H 'Content-Type: message/rfc822' --data-binary @./scripts/test-email.eml",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "hono": "^4.6.0",
    "postal-mime": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
