{
  "name": "agentic-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy --config dist/agentic_inbox/wrangler.json",
    "deploy:mcp": "wrangler deploy --config wrangler.mcp.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply agentic-inbox --local",
    "db:migrate": "wrangler d1 migrations apply agentic-inbox --remote",
    "db:seed:local": "wrangler d1 execute agentic-inbox --local --file=./scripts/seed.sql",
    "email:test": "curl -X POST 'http://localhost:5173/cdn-cgi/handler/email?from=customer@example.com&to=support@yourdomain.com' -H 'Content-Type: message/rfc822' --data-binary @./scripts/test-email.eml",
    "email:test:attachment": "curl -X POST 'http://localhost:5173/cdn-cgi/handler/email?from=forms@example.com&to=support@yourdomain.com' -H 'Content-Type: message/rfc822' --data-binary @./scripts/test-email-attachment.eml",
    "email:test:reopen": "curl -X POST 'http://localhost:5173/cdn-cgi/handler/email?from=forms@example.com&to=support@yourdomain.com' -H 'Content-Type: message/rfc822' --data-binary @./scripts/test-email-reopen.eml",
    "vapid:generate": "pushforge vapid",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@pushforge/builder": "^2.0.5",
    "@tanstack/react-query": "^5.59.0",
    "agents": "0.22.0",
    "ai": "^7.0.70",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "postal-mime": "^2.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
