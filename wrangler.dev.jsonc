// Local-dev-only config: no `ai` / `send_email` bindings, because both force a
// remote proxy session (blocked by Cloudflare Access on this account) and
// neither is needed for UI iteration. Deploys use wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-inbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cdn-cgi/handler/email"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-inbox",
      "database_id": "c4bee2a2-df80-45f0-9df5-4a1d9804d0a0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "agentic-inbox-raw"
    }
  ]
}
